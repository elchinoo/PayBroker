# Copy to .env (git-ignored). LOCAL development only; never commit real credentials.
# Password for the local docker-compose database. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://paybroker:${POSTGRES_PASSWORD}@127.0.0.1:5435/paybroker

# Optional: the public base URL used in 3-D Secure challenge links (defaults to the request's own address).
# PAYBROKER_PUBLIC_URL=https://paybroker.example.com
# Optional: platform secret that lets the vault unlock itself after a restart (webhooks and LLM keys need it).
# PAYBROKER_ENCRYPTION_KEY=
# Optional: allow LLM provider and webhook URLs on localhost/private networks (local testing only).
# PAYBROKER_ALLOW_PRIVATE_URLS=true
# api (HTTP only), worker (background jobs only) or all (default)
# PAYBROKER_ROLE=all

# Single sign-on with the ecosystem identity provider (https://github.com/elchinoo/identity). Off when the issuer is unset.
# PAYBROKER_OIDC_ISSUER=https://identity.example.com
# PAYBROKER_OIDC_CLIENT_ID=paybroker
# PAYBROKER_OIDC_CLIENT_SECRET=
# PAYBROKER_LOCAL_LOGIN=false      # remove the admin-password login when SSO is on (default keeps it as break-glass)
